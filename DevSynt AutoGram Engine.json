        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Generate an Instagram caption for the image. You MUST return ONLY valid JSON. Do not include markdown, explanations, or any other text. Use exactly this format: {\\\"caption\\\":\\\"your caption here\\\",\\\"hashtags\\\":[\\\"#hashtag1\\\",\\\"#hashtag2\\\",\\\"#hashtag3\\\"]}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
