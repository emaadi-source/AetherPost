    {
      "parameters": {
        "jsCode": "const raw=$json?.candidates?.[0]?.content?.parts?.[0]?.text||''; const s=raw.replace(/^```json\\s*/i,'').replace(/```$/i,'').trim(); let x; try{x=JSON.parse(s)}catch(e){throw new Error('AI returned invalid JSON')} if(!x.caption||!Array.isArray(x.hashtags)) throw new Error('Missing caption or hashtags'); const h=x.hashtags.map(v=>String(v).startsWith('#')?String(v):'#'+String(v).replace(/\\s+/g,'')); return [{json:{...$node['Build Public Image URL'].json,caption:x.caption,hashtags:h,fullCaption:x.caption+'\\n\\n'+h.join(' ')}}];"
      },
